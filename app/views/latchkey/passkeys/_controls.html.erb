<div data-controller="latchkey-passkey"
  data-latchkey-passkey-options-url-value="<%= options_url %>"
  data-latchkey-passkey-finish-url-value="<%= finish_url %>"
  data-latchkey-passkey-mode-value="<%= mode %>"
  data-latchkey-passkey-purpose-value="<%= local_assigns[:purpose] %>"
  data-latchkey-passkey-conditional-value="<%= local_assigns.fetch(:conditional, false) && !Latchkey.configuration.challenge_on.include?(action) %>"
  data-latchkey-passkey-csrf-value="<%= form_authenticity_token %>"
  data-action="turbo:before-cache@document->latchkey-passkey#beforeCache submit@document->latchkey-passkey#otherSubmission">
  <p data-latchkey-passkey-target="unavailable">Passkeys need JavaScript and a compatible browser or device. Use another method allowed by your account policy if available.</p>
  <%= form_with url: options_url, data: latchkey_challenge_form_data(action).merge(latchkey_passkey_target: "form", action: [latchkey_challenge_form_data(action)[:action], "submit->latchkey-passkey#submit"].compact.join(" ")) do |form| %>
    <%= latchkey_challenge_tag action, id: "passkey_#{action}" %>
    <div hidden data-latchkey-passkey-target="controls">
      <%= form.submit label, class: latchkey_class(:button), data: {latchkey_challenge_target: "submit", latchkey_passkey_target: "button"} %>
    </div>
  <% end %>
  <p role="status" aria-live="polite" tabindex="-1" hidden data-latchkey-passkey-target="status"></p>
</div>
