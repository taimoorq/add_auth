<% content_for :title, "Sign out everywhere" %>
<h1 id="latchkey-title">Sign out everywhere</h1>
<p class="<%= latchkey_class(:muted) %>">Revoke every active session, including this browser. This requires a recent verification.</p>
<% if @error %><p class="<%= latchkey_class(:notice) %>" role="alert"><%= @error %></p><% end %>
<% if @elevated || @password_available != false %>
<%= form_with url: "/sessions/revoke-all", data: latchkey_challenge_form_data(:reauthenticate) do |form| %>
  <% unless @elevated %>
  <div class="<%= latchkey_class(:field) %>">
    <%= form.label :password, "Current password" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", class: latchkey_class(:input) %>
  </div>
  <% end %>
  <%= latchkey_challenge_tag :reauthenticate %>
  <%= form.submit "Sign out everywhere", class: latchkey_class(:button), data: {latchkey_challenge_target: "submit"} %>
<% end %>
<% end %>
<% if Latchkey.configuration.step_up.enabled %><p><%= link_to "Verify with an allowed method", "/reauthenticate?purpose=sign_out_everywhere" %></p><% end %>
<p><%= link_to "Cancel", "/sessions", class: latchkey_class(:link) %></p>
