<% content_for :title, "Sessions" %>
<% content_for :head do %>
  <% turbo_exempts_page_from_cache %>
  <% turbo_page_requires_reload if request.headers["Turbo-Frame"].present? %>
  <%= stylesheet_link_tag latchkey_stylesheet, skip_pipeline: true if latchkey_stylesheet %>
<% end %>
<main class="<%= latchkey_class(:panel) %>" aria-labelledby="latchkey-title">
  <h1 id="latchkey-title">Your sessions</h1>
  <p class="<%= latchkey_class(:muted) %>">Review browsers signed in to your account and revoke any you no longer use.</p>
  <p><%= link_to "Sign out everywhere", "/sessions/revoke-all", class: latchkey_class(:link) %></p>
  <div id="latchkey-session-content"><%= render "latchkey/sessions/list" %></div>
</main>
